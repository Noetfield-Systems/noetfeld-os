{
  "schema": "noetfield-company-growth-engine-v1",
  "version": "1.0.0",
  "status": "manual_on_demand",
  "roles": {
    "intelligence": "N-02",
    "revenue": "N-05"
  },
  "source_registry": "data/company-intelligence-source-registry-v1.json",
  "source_schema": "schemas/company-intelligence-source-registry-v1.schema.json",
  "opportunity_schema": "schemas/company-opportunity-v1.schema.json",
  "runtime_entrypoint": "scripts/noetfield_company_growth_engine_v1.py",
  "runbook": "docs/company-workforce/GROWTH_ENGINE_RUNBOOK_v1.md",
  "persistence": {
    "default": ".noos-runtime/workforce/company-growth-v1.sqlite3",
    "durable_storage_required_before_scheduling": true
  },
  "execution": {
    "feed_ingestion": "explicit_cli_https_allowlist_only",
    "signal_analysis": {
      "task_kind": "classify",
      "executor_tier": "T1",
      "provider": "openrouter_free",
      "requires_secret": "OPENROUTER_API_KEY",
      "tool_access": false,
      "max_per_run_usd": 0.01,
      "max_rolling_24h_usd": 0.5
    },
    "revenue_pipeline": "deterministic_sqlite_internal_records",
    "external_actions": "prohibited"
  },
  "activation_gaps": [
    "Provision OPENROUTER_API_KEY in the approved secret store.",
    "Validate provider model availability and actual usage-cost reporting.",
    "Mount or provision durable database storage before recurring execution.",
    "Only then map fetch/analyze invocations onto existing NOOS loop machinery."
  ],
  "observability": {
    "trace_table": "agent_run_traces",
    "cli_command": "traces",
    "stored_fields": [
      "role_id",
      "task_kind",
      "source_id",
      "source_url",
      "source_digest",
      "prompt_digest",
      "output_digest",
      "model_id",
      "status",
      "policy_decision",
      "tool_calls_json",
      "reserved_usd",
      "actual_usd",
      "error_code"
    ],
    "raw_prompts_stored": false,
    "chain_of_thought_stored": false,
    "tool_access": false
  },
  "pipeline_authority": {
    "qualification_transition_requires": "NOETFIELD_PIPELINE_APPROVAL_TOKEN",
    "reviewer_role": "H-001",
    "token_location": "expected value in approved process environment; supplied value entered by hidden interactive prompt",
    "token_in_arguments": false,
    "token_in_evidence": false,
    "token_in_receipts": false,
    "other_stage_transitions": "N-05 evidence-driven bounded updates",
    "proposal_ready_for_founder_review": "queues a draft for review; does not approve or send"
  }
}
