{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noetfield.com/schemas/company-intelligence-source-registry-v1.schema.json",
  "title": "Noetfield Company Intelligence Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "refresh_mode",
    "feeds",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "noetfield-company-intelligence-source-registry-v1"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "const": "approved_public_feeds_manual_on_demand"
    },
    "refresh_mode": {
      "const": "manual_only_until_persistent_runtime_is_verified"
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "publisher",
          "feed_url",
          "verification_url",
          "allowed_link_domains",
          "commercial_fields",
          "topics",
          "trust_tier",
          "enabled",
          "max_items_per_fetch"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "feed_url": {
            "type": "string",
            "format": "uri"
          },
          "verification_url": {
            "type": "string",
            "format": "uri"
          },
          "allowed_link_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "commercial_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "enterprise_ai_governance",
                "custom_ai_motors",
                "investor_workflows"
              ]
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trust_tier": {
            "enum": [
              "first_party",
              "first_party_domain_feed"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_items_per_fetch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_only",
        "redirects_allowed",
        "maximum_feed_bytes",
        "maximum_entry_text_chars",
        "maximum_entries_per_source",
        "reject_doctype_and_entity_declarations",
        "untrusted_source_content_is_data_not_instructions",
        "no_external_actions"
      ],
      "properties": {
        "https_only": {
          "const": true
        },
        "redirects_allowed": {
          "const": false
        },
        "maximum_feed_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2000000
        },
        "maximum_entry_text_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "maximum_entries_per_source": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "reject_doctype_and_entity_declarations": {
          "const": true
        },
        "untrusted_source_content_is_data_not_instructions": {
          "const": true
        },
        "no_external_actions": {
          "const": true
        }
      }
    }
  }
}
